# Variáveis opcionais lidas pelo docker-compose (passthrough para a API).
# Copie para .env e preencha só o que for usar. Tudo tem padrão seguro.

# Modelo do Ollama
OLLAMA_MODEL=llama3

# Provedores de mídia: placeholder (padrão, FFmpeg) | stability | elevenlabs
ANE_IMAGE_PROVIDER=placeholder
ANE_VOICE_PROVIDER=placeholder

# Publicação: none (padrão) | youtube
ANE_PUBLISHER=none

# Chaves (só se trocar o provedor acima)
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
