# Variáveis opcionais lidas pelo docker-compose (passthrough para a API).
# Copie para .env e preencha só o que for usar. Tudo tem padrão seguro.

# Provedor de LLM de texto: ollama (padrão) | gemini
ANE_TEXT_PROVIDER=ollama
# Modelo do Ollama
OLLAMA_MODEL=llama3
# Modelo de texto do Gemini (se ANE_TEXT_PROVIDER=gemini)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Provedores de imagem: placeholder (padrão, FFmpeg) | stability | gemini
ANE_IMAGE_PROVIDER=placeholder
# Provedores de voz: placeholder | piper (TTS local PT-BR, offline) | elevenlabs
ANE_VOICE_PROVIDER=piper
# Caminho do modelo Piper (já incluído na imagem Docker)
PIPER_MODEL=/app/voices/pt_BR-faber-medium.onnx
# Provedor de VÍDEO por cena: none (padrão, usa imagem) | gemini (Veo)
ANE_VIDEO_PROVIDER=none

# Autenticação da API (vazio = aberto no localhost). Se definido, o frontend e
# o bot precisam enviar o mesmo valor no cabeçalho X-API-Key.
ANE_API_KEY=

# Publicação: none (padrão) | youtube
ANE_PUBLISHER=none

# Bot do Telegram (serviço opt-in: docker compose --profile bot up -d)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Gemini (imagem via Imagen e/ou vídeo via Veo)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Outras chaves (só se trocar o provedor acima)
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
