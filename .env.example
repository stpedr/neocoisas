# Variáveis opcionais lidas pelo docker-compose (passthrough para a API).
# Copie para .env e preencha só o que for usar. Tudo tem padrão seguro.

# Modelo do Ollama
OLLAMA_MODEL=llama3

# Provedores de imagem: placeholder (padrão, FFmpeg) | stability | gemini
ANE_IMAGE_PROVIDER=placeholder
# Provedores de voz: placeholder (padrão) | elevenlabs
ANE_VOICE_PROVIDER=placeholder
# Provedor de VÍDEO por cena: none (padrão, usa imagem) | gemini (Veo)
ANE_VIDEO_PROVIDER=none

# Publicação: none (padrão) | youtube
ANE_PUBLISHER=none

# Gemini (imagem via Imagen e/ou vídeo via Veo)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# Outras chaves (só se trocar o provedor acima)
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
