# Variáveis opcionais lidas pelo docker-compose (passthrough para a API).
# Copie para .env e preencha só o que for usar. Tudo tem padrão seguro.

# Provedor de LLM de texto: ollama (padrão) | gemini
ANE_TEXT_PROVIDER=ollama
# Modelo do Ollama
OLLAMA_MODEL=llama3
# Modelo de texto do Gemini (se ANE_TEXT_PROVIDER=gemini)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Provedores de imagem: placeholder | a1111 | comfyui | stability | gemini
ANE_IMAGE_PROVIDER=placeholder
# Stable Diffusion local (AUTOMATIC1111 com --api).
#  - A1111 nativo no seu PC:            A1111_URL=http://host.docker.internal:7860
#  - A1111 no compose (profile sd):     A1111_URL=http://a1111:7860
A1111_URL=http://host.docker.internal:7860
# ComfyUI local (imagem e/ou text-to-video). Exporte o workflow em "formato API"
# com o marcador %prompt% e coloque na pasta ./comfyui (montada em /app/comfyui).
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_IMAGE_WORKFLOW=/app/comfyui/image_api.json
COMFYUI_VIDEO_WORKFLOW=/app/comfyui/video_api.json
# Provedores de voz: placeholder | piper (TTS local PT-BR, offline) | elevenlabs
ANE_VOICE_PROVIDER=piper
# Caminho do modelo Piper (já incluído na imagem Docker)
PIPER_MODEL=/app/voices/pt_BR-faber-medium.onnx
# Provedor de VÍDEO por cena: none (padrão, usa imagem) | gemini (Veo)
ANE_VIDEO_PROVIDER=none

# Autenticação da API (vazio = aberto no localhost). Se definido, o frontend e
# o bot precisam enviar o mesmo valor no cabeçalho X-API-Key.
ANE_API_KEY=

# Publicação: none (padrão) | youtube
ANE_PUBLISHER=none

# Bot do Telegram (serviço opt-in: docker compose --profile bot up -d)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Gemini (imagem via Imagen e/ou vídeo via Veo)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Outras chaves (só se trocar o provedor acima)
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Controlador Raspberry Pi (opt-in: docker compose --profile rpi up -d rpi, no Pi)
# ANE_API_URL=http://<ip-do-servidor>:8000   # se a API não roda no próprio Pi
RPI_BACKEND=gpiozero        # gpiozero | mock (teclado, para testar no PC)
RPI_POLL_INTERVAL=5
# Pinos BCM (padrões): botões APPROVE=17 REJECT=27 RENDER=22 PUBLISH=23 GENERATE=24
#                      LEDs PENDING=5 BUSY=6 ERROR=13
# RPI_PIN_APPROVE=17

# ProjMap — transmissão RTSP da camada interativa (opcional)
# Publica no servidor a cena/efeito que a camada interativa está mostrando.
# A URL leva usuário e senha, por isso fica só aqui (o .env está no .gitignore)
# e nunca na linha de comando, onde apareceria na lista de processos.
# Para assistir:
#   ffplay -rtsp_transport tcp -fflags nobuffer -flags low_delay "rtsp://.../cam"
# PROJMAP_RTSP_URL=rtsp://usuario:senha@servidor:8554/caminho
PROJMAP_RTSP_SIZE=1280x720
PROJMAP_RTSP_FPS=30
PROJMAP_RTSP_BITRATE=4M
PROJMAP_RTSP_TRANSPORT=tcp     # tcp (padrão) | udp

# ---- ProjMap: Google Drive direto na galeria (projmap/gdrive.py)
# Modo OAuth (pasta PRIVADA, recomendado): crie no Google Cloud um cliente OAuth
# do tipo "App para computador", ative a Google Drive API e cole aqui. Depois,
# no editor: Mídias → Google Drive → "Conectar Google Drive".
PROJMAP_GDRIVE_CLIENT_ID=
PROJMAP_GDRIVE_CLIENT_SECRET=
# Modo chave de API (sem login): pasta compartilhada como "qualquer pessoa com o link".
PROJMAP_GDRIVE_API_KEY=
# Link (ou id) da pasta raiz da galeria. Também dá para colar no editor.
PROJMAP_GDRIVE_FOLDER=
# Força o modo: oauth | apikey | off (vazio = automático pelas chaves acima)
PROJMAP_GDRIVE=
