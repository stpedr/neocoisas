# API FastAPI do Auto Niche Engine.
FROM python:3.11-slim

WORKDIR /app

# FFmpeg (render) + fonte DejaVu (legendas) + curl (baixar a voz do Piper).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core curl \
    && rm -rf /var/lib/apt/lists/*

# Dependências primeiro (melhor cache de camadas).
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# TTS local (Piper) + voz PT-BR (offline, sem chave).
ARG PIPER_VOICE_BASE=https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_BR/faber/medium
RUN mkdir -p /app/voices \
    && curl -fsSL -o /app/voices/pt_BR-faber-medium.onnx "${PIPER_VOICE_BASE}/pt_BR-faber-medium.onnx" \
    && curl -fsSL -o /app/voices/pt_BR-faber-medium.onnx.json "${PIPER_VOICE_BASE}/pt_BR-faber-medium.onnx.json"

# Código da aplicação (o .dockerignore exclui web/, output/, etc.).
COPY . .

# Diretório de estado persistido (montado como volume no compose).
RUN mkdir -p /app/output

EXPOSE 8000

# 0.0.0.0 para ser acessível fora do container.
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
