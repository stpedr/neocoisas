# ============================================================================
# ProjMap Standalone — Variáveis de Ambiente (.env.projmap)
# Copie para `.env.projmap` (ou `.env`) na raiz do repositório.
# O ProjMap funciona 100% offline/local mesmo sem nenhuma variável configurada.
# ============================================================================

# Diretórios locais da máquina (opcional; padrão: ~/.projmap)
# PROJMAP_CONFIG_DIR=~/.projmap
# PROJMAP_SCENES_DIR=~/.projmap/scenes
# PROJMAP_FACE_MODEL=models/face_landmarker.task
# PROJMAP_MAX_PHOTO_MB=25

# Token fixo para o controle remoto no celular na LAN (opcional; se vazio, gera a cada execução)
# PROJMAP_TOKEN=

# ----------------------------------------------------------------------------
# Geração de Cenas Interativas por Texto (NLP Standalone — opcional)
# Sem LLM configurado, o ProjMap usa o parser determinístico por palavras-chave.
# ----------------------------------------------------------------------------
# PROJMAP_LLM_PROVIDER=ollama          # ollama | gemini | off
# PROJMAP_OLLAMA_URL=http://127.0.0.1:11434
# PROJMAP_OLLAMA_MODEL=qwen2.5:14b
# PROJMAP_GEMINI_API_KEY=
# PROJMAP_GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# Google Drive na Galeria de Mídias (opcional)
# ----------------------------------------------------------------------------
# PROJMAP_GDRIVE_FOLDER=
# PROJMAP_GDRIVE_CLIENT_ID=
# PROJMAP_GDRIVE_CLIENT_SECRET=
# PROJMAP_GDRIVE_API_KEY=

# ----------------------------------------------------------------------------
# Transmissão RTSP da Camada Interativa (opcional)
# ----------------------------------------------------------------------------
# PROJMAP_RTSP_URL=rtsp://usuario:senha@127.0.0.1:8554/projmap
# PROJMAP_RTSP_SIZE=1280x720
# PROJMAP_RTSP_FPS=30
# PROJMAP_RTSP_BITRATE=4M
# PROJMAP_RTSP_TRANSPORT=tcp
