{
  "appId": "io.neocoisas.projmap",
  "appName": "ProjMap Remote",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "localhost",
      "127.0.0.1",
      "10.*.*.*",
      "172.*.*.*",
      "192.168.*.*"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "appendUserAgent": "ProjMapApp",
    "adjustMarginsForEdgeToEdge": "force"
  }
}
