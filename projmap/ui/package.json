{
  "name": "projmap-ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI do mestre ProjMap: editor de mapeamento sobre a foto (export estático servido pelo FastAPI).",
  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && next dev -p 3100",
